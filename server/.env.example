# Server environment variables example
# Copy this file to .env and fill values before running the server.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce-demo

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_here

# Cloudinary credentials (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe secret key for card payments
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Stripe currency code (defaults to lkr if not specified, e.g. lkr, inr, usd)
STRIPE_CURRENCY=lkr

# Firebase Admin service account - required for Firebase token verification
# Use either a path to a service account JSON file or the raw JSON string.
FIREBASE_SERVICE_ACCOUNT_PATH=../artncraft-ac7ae-firebase-adminsdk-fbsvc-599ca53d9e.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: server port
PORT=5000
PORT=5000
